<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="in" class="java.util.HashMap">
        <constructor-arg>
            <map>
                <entry key="code" value="IN"/>
                <entry key="name" value="India"/>
            </map>
        </constructor-arg>
    </bean>

    <bean id="countryList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <map>
                    <entry key="code" value="IN"/>
                    <entry key="name" value="India"/>
                </map>
                <map>
                    <entry key="code" value="US"/>
                    <entry key="name" value="United States"/>
                </map>
                <map>
                    <entry key="code" value="JP"/>
                    <entry key="name" value="Japan"/>
                </map>
            </list>
        </constructor-arg>
    </bean>
</beans>